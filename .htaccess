# Block direct web access to sensitive files (defense-in-depth).
# PHP includes still work — this only blocks HTTP requests to these files.

<FilesMatch "(?i)\.(zip|sql|log|md|example|gitignore|gitattributes|ini)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "(?i)^(config\.php|config\.local\.php|error_log)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Prevent directory listing
Options -Indexes
